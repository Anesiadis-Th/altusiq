<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6eddc487-fa9d-4cc6-a5b3-17182a1156e2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned, not 8.*: floating pulled EF Relational 8.0.28 while Npgsql pins
         8.0.11, and the skew surfaces as MSB3277 in any project referencing this one. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="8.0.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
  </ItemGroup>

  <!-- This csproj sits at backend/ root, so the SDK globs every .cs beneath it,
       test project included. Without these the API tries to compile the tests. -->
  <ItemGroup>
    <Compile Remove="AltusIQ.Api.Tests/**" />
    <Content Remove="AltusIQ.Api.Tests/**" />
    <EmbeddedResource Remove="AltusIQ.Api.Tests/**" />
    <None Remove="AltusIQ.Api.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AltusIQ.Api.Tests" />
  </ItemGroup>

</Project>
