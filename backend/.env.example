# Investigation model keys. Both providers are free plans with no card on file.
# Set these as Fly secrets in production (fly secrets set GROQ_API_KEY=...);
# locally, export them before `dotnet run`. Placeholders, replace before use.
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# Eval harness live mode (optional). Leave unset for replay mode.
# LLM_PROVIDER is a provider name from appsettings Llm:Providers (groq or openrouter).
LLM_PROVIDER=
LLM_API_KEY=
